# Postgres já existente no host (ex: via Docker Desktop / pgAdmin — ver
# scripts/00-setup.sql e scripts/create.sql de cada API .NET para criar
# os bancos/usuários "aventuraorganizada-*").
POSTGRES_HOST=host.docker.internal
POSTGRES_PORT=5432
POSTGRES_PASSWORD=123

# Cognito — FAKE até o User Pool real existir (ver READMEs das APIs).
COGNITO_REGION=us-east-1
COGNITO_USER_POOL_ID=us-east-1_FAKEPOOL1
COGNITO_CLIENT_ID=fakeclientid00000000000000

# Segredo compartilhado entre marketplace-api e prestadores-api (chamadas
# servidor-a-servidor via InternoController, header X-Chave-Interna) — só
# precisa ser o mesmo valor nos dois, não é lido por mais nenhum serviço.
# Gere algo aleatório pra qualquer ambiente além do local (ex: openssl rand -hex 32).
CHAVE_INTERNA=chave-interna-local-123
