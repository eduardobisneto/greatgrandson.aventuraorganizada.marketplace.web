# Postgres já existente no host (ex: via Docker Desktop / pgAdmin — ver
# scripts/00-setup.sql e scripts/create.sql de cada API .NET para criar
# os bancos/usuários "aventuraorganizada-*").
POSTGRES_HOST=host.docker.internal
POSTGRES_PORT=5432
POSTGRES_PASSWORD=123

# Cognito — FAKE até o User Pool real existir (ver READMEs das APIs).
COGNITO_REGION=us-east-1
COGNITO_USER_POOL_ID=us-east-1_FAKEPOOL1
COGNITO_CLIENT_ID=fakeclientid00000000000000

# marketplace.api consumida por este front (ver src/lib/api-config.ts).
# Default assume o serviço rodando localmente.
VITE_MARKETPLACE_API_URL=http://localhost:5001
